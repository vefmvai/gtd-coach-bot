# Телеграм
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Мозги — по подписке Claude, а не по API-токену
CLAUDE_CODE_OAUTH_TOKEN=

# Голос (Whisper) — основной вход бота. Два сервиса подряд, оба крутят Whisper.
# Основной с 2026-07-27 — Groq: то же самое, но на их железе (LPU), быстрее и в
# пределах щедрого бесплатного тира бесплатно. Ключ с console.groq.com.
# ⚠️ Groq доступен не из всех стран (403 напрямую) — тогда нужен HTTPS_PROXY ниже.
STT_API_KEY=
# Необязательные: без них берутся адрес Groq и whisper-large-v3-turbo.
# STT_API_URL=
# STT_MODEL=

# Запасной сервис: на ЛЮБОЙ осечке Groq бот сразу уходит сюда (whisper-1, платный
# ~$0.36 за час аудио). Он же становится основным, если STT_API_KEY пуст.
OPENAI_API_KEY=
# Необязательные: без них берутся адрес OpenAI и whisper-1.
# FALLBACK_STT_API_URL=
# FALLBACK_STT_MODEL=

# Дела
TODOIST_API_TOKEN=

# Google Календарь (события со слотом времени). Пусто — календарь просто
# не подключается, всё остальное работает.
#
# Как получить свои три значения:
#  1. console.cloud.google.com → новый проект → включить Google Calendar API.
#  2. «Credentials» → OAuth client ID → тип Desktop app. Отсюда CLIENT_ID
#     и CLIENT_SECRET.
#  3. Один раз пройти вход в браузере со scope .../auth/calendar и забрать
#     refresh-token (годится любой пример OAuth-обмена на своём языке).
#  4. Приложение опубликовать в Production, иначе refresh-token протухнет
#     через семь дней и календарь молча отвалится.
# GOOGLE_CALENDAR_ID=primary — основной календарь аккаунта.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Прокси для исходящих запросов — нужен там, где сервисы недоступны напрямую
# (Groq и Google блокируют часть стран). Не нужен — оставь пустым или убери строку.
# HTTPS_PROXY=http://127.0.0.1:1080

# Часовой пояс коуча: в нём он называет время и по нему шлёт чек-ины.
# Имя из базы IANA: Europe/Lisbon, Asia/Makassar, America/New_York…
COACH_TZ=Europe/Moscow

# Расписания здесь больше нет — оно переехало в мозг, в
# память/состояние/ритмы.md (строгий YAML со схемой). Причина: ритм — настройка
# про человека, а не про инфраструктуру. Из .env его мог поменять только тот,
# у кого есть ssh, и только с перезапуском; из мозга — фразой в телеграме.
# Переменные MORNING_TIME / MIDDAY_TIME / EVENING_TIME / DIGEST_TIME /
# FOLLOWUP_MINUTES / QUIET_HOUR больше не читаются.

# Имя контейнера. Нужно только второй копии коуча на том же сервере (второй
# человек: своя папка, свой бот, своя память). Первой установке не нужно —
# без строки контейнер зовётся gtd-coach-bot.
# CONTAINER_NAME=gtd-coach-bot-2

# Модели
COACH_MODEL=claude-fable-5
COACH_EFFORT=medium
DIGEST_MODEL=claude-fable-5

# Сколько выжимок подгружать в начало нового разговора — НЕ настройка.
# Окно фиксировано в коде (src/archive.py, WINDOW): 7 дней + 5 недель + 3 месяца.
# Прежняя переменная MEMORY_DAYS убрана: размер блока должен быть известен
# умножением, а не зависеть от строки в .env на сервере.
#
# Модель, режим контекста, тумблеры кнопок и словарь голоса тоже живут не здесь,
# а в мозге: память/состояние/настройки.md. Меняются фразой в телеграме.
